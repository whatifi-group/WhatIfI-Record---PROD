# WhatIfI Record — environment variables
#
# On the VPS these live in artifacts/api-server/ecosystem.config.cjs (untracked,
# per-deployment). deploy.sh restarts pm2 via the ecosystem file rather than by
# app name, so changes here are picked up on the next deploy.
#
# Copy to .env for local development.

# ── Required — the server refuses to boot without these ──────────────────────

# Postgres connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/whatifi_record

# Signs the session cookie AND the onboarding-portal JWT (lib/onboardingJwt.ts).
# Rotating it invalidates every active session and any in-flight onboarding link.
SESSION_SECRET=change-me-to-a-long-random-string

# Port the API server listens on.
PORT=8080

# ── Deployment identity ──────────────────────────────────────────────────────

# "development" makes GET /api/environment report DEV, which themes the UI so
# the two deployments are visually distinguishable. Anything else = production.
APP_ENV=development

# Gates the secure session cookie (HTTPS-only) and pino pretty-printing.
NODE_ENV=development

# Base URL of this deployment. Used for password-reset links, email links, and
# where the SSO callback sends the browser after a successful sign-in.
APP_URL=https://record.whatifigroup.co.uk

# ── Microsoft Entra ID (Azure AD) SSO ────────────────────────────────────────
#
# All four must be set for SSO to be enabled. When any is missing,
# GET /api/environment reports ssoEnabled:false, the /auth/sso routes return
# 503, and the login page falls back to the break-glass password form.
#
# DEV and PROD share ONE app registration and differ only by AZURE_REDIRECT_URI;
# both URIs must be registered on that app in Entra.

# Directory (tenant) ID — pins sign-in to the WhatIfI tenant.
AZURE_TENANT_ID=

# Application (client) ID of the app registration.
AZURE_CLIENT_ID=

# Client secret from the same registration. Rotate before it expires.
AZURE_CLIENT_SECRET=

# This deployment's callback. Must match a redirect URI registered in Entra,
# e.g. https://record.whatifigroup.co.uk/api/auth/sso/callback
AZURE_REDIRECT_URI=

# Role granted to users auto-provisioned on first SSO sign-in.
# Defaults to "Employee Self-Service" when unset.
SSO_DEFAULT_ROLE_NAME=

# ── Email (Brevo) ────────────────────────────────────────────────────────────
# Without BREVO_API_KEY, email is logged and skipped rather than sent.

BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@whatifigroup.co.uk
BREVO_SENDER_NAME=WhatIfI Record

# ── Object storage ───────────────────────────────────────────────────────────

# HMAC secret for time-limited local upload/download URLs.
OBJECT_STORAGE_SIGNING_SECRET=
OBJECT_STORAGE_DIR=/var/lib/whatifi-record/storage

# ── Optional ─────────────────────────────────────────────────────────────────

# Force-resets the system administrator's password on every boot. Use only to
# recover a locked-out instance, then remove it.
# ADMIN_SEED_PASSWORD=

# LOG_LEVEL=info
# UPLOAD_MAX_BYTES=20971520
# QUALIFICATION_REMINDER_WITHIN_DAYS=30
# DBS_REMINDER_WITHIN_DAYS=30
